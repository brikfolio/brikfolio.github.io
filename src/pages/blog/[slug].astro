---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, isoDate, absolute } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, author, cover, cover_alt, draft } = post.data;
const path = `/blog/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': absolute(`${path}#article`),
      url: absolute(path),
      mainEntityOfPage: absolute(path),
      headline: title,
      description,
      datePublished: isoDate(date),
      inLanguage: 'en-AU',
      ...(cover && { image: absolute(cover) }),
      author: author
        ? { '@type': 'Person', name: author }
        : { '@id': absolute('/#organization') },
      publisher: { '@id': absolute('/#organization') },
      isPartOf: { '@id': absolute('/blog/#blog') },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': absolute(`${path}#breadcrumb`),
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: absolute('/blog/') },
        { '@type': 'ListItem', position: 3, name: title, item: absolute(path) },
      ],
    },
  ],
};
---

<Base
  title={`${title} | Brikfolio`}
  description={description}
  path={path}
  ogType="article"
  image={cover}
  imageAlt={cover ? cover_alt ?? title : undefined}
  jsonLd={jsonLd}
>
  <meta slot="head" property="article:published_time" content={isoDate(date)} />

  <article class="post">
    <div class="container">
      <a class="post__back" href="/blog/">← All posts</a>
      <header class="post__header">
        <h1>{title}</h1>
        <p class="post-meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {author && <span> · {author}</span>}
          {draft && <span class="post-meta__draft">Draft: not on the live site</span>}
        </p>
      </header>

      {cover && <img class="post__cover" src={cover} alt={cover_alt ?? ''} decoding="async" />}

      <div class="prose">
        <Content />
      </div>

      <aside class="post__cta" aria-label="Join the Brikfolio waitlist">
        <h2>Manage your property portfolio in one place</h2>
        <p>Join the waitlist to get early access to Brikfolio.</p>
        <a class="btn btn--primary" href="https://brikfolio.app/joinwishlist" data-cta="blog">Join waitlist</a>
      </aside>
    </div>
  </article>
</Base>
